# Dual-Mode Execution Environment: local | gcp
ENV=local
GCP_PROJECT_ID=comm-model-mod
GCP_REGION=us-central1
GCP_ZONE=us-central1-a
BQ_LOCATION=us-central1
GEMINI_LOCATION=us
BQ_DATASET_ID=sheets_commodity_mod_governance

# Universal Resource Label
APP_LABEL=sheets-commodity-mod

# Seed Baseline Workbook (Read-Only)
SEED_WORKBOOK_PATH=seed/2023-11-27-Brazil_TT_v13_RJEB.xlsm
BASELINE_FIXTURE_PATH=data/fixtures/brazil_tt_v13_baseline.json

# Database & Storage Configuration
DATABASE_URL=sqlite+aiosqlite:///./data/local_alloydb_parity.db
LOCAL_SNAPSHOT_DIR=./data/snapshots
LOCAL_BQ_SINK_DIR=./data/bigquery_sink
GCS_SNAPSHOT_BUCKET=comm-model-mod-sheets-mod-snapshots
GCS_ARTIFACTS_BUCKET=comm-model-mod-sheets-mod-artifacts

# Vertex AI & Cloud Run Solver Configuration
ENABLE_VERTEX_REMOTE_PREDICT=false
VERTEX_ENDPOINT_ID=sheets-commodity-mod-solver-ep
VERTEX_MODEL_NAME=sheets-commodity-mod-lcoe-solver
LOCAL_DEV_AUTH_BYPASS=true
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000
